{
  "name": "cloudguardian",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @cg/api\" \"npm run dev -w @cg/web\"",
    "build": "npm run build -w @cg/api && npm run build -w @cg/web",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @cg/api",
    "db:seed": "npm run db:seed -w @cg/api",
    "db:reset": "npm run db:reset -w @cg/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
