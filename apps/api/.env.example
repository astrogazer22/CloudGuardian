DATABASE_URL="postgresql://cloudguardian:cloudguardian@localhost:5432/cloudguardian?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Run BullMQ workers and cron schedules inside the API process
RUN_WORKERS=true
# Full AWS inventory scan interval (cron expression)
AWS_SYNC_CRON="0 */6 * * *"
# Region used for STS AssumeRole calls
AWS_STS_REGION="us-east-1"
# Auto-create incident tickets for unhealthy load balancer targets
AUTO_TICKETS=true
# Days a ticket may sit in "resolved" before it is closed automatically
AUTO_CLOSE_DAYS=7
# Public URLs used in chat links and Slack app configuration
APP_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:4000"
# Slack app (slash command /cg + Approve/Reject buttons). Channel webhooks are configured in the UI.
# SLACK_SIGNING_SECRET=""
# SLACK_BOT_TOKEN="xoxb-..."
# IAM role CloudGuardian runs as; trusted by the per-account onboarding template
# CLOUDGUARDIAN_PRINCIPAL_ARN="arn:aws:iam::123456789012:role/cloudguardian"
# Default AWS credential chain used when an account has no stored keys or role ARN
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""
# AWS_REGION="us-east-1"
# ALLOW_DEMO_AWS="false"
# Trend Micro Cloud One Workload Security (optional)
# TRENDMICRO_API_URL="https://app.deepsecurity.trendmicro.com/api"
# TRENDMICRO_API_KEY=""
