generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
  APPROVER
  VIEWER
  REQUESTER
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String
  /// Base role (kept in sync with roleDef.baseRole); drives persona-level behaviour such as the requester portal.
  role           Role            @default(AGENT)
  roleId         String?
  roleDef        RoleDefinition? @relation(fields: [roleId], references: [id])
  active         Boolean         @default(true)
  title          String?
  timezone       String          @default("UTC")
  skills         String[]
  lastAssignedAt DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  teams            TeamMember[]
  assignedTickets  Ticket[]           @relation("TicketAssignee")
  requestedTickets Ticket[]           @relation("TicketRequester")
  comments         Comment[]
  notifications    Notification[]
  approvalsAsked   ApprovalRequest[]  @relation("ApprovalRequester")
  approvalsDecided ApprovalRequest[]  @relation("ApprovalDecider")
  ticketEvents     TicketEvent[]
  auditLogs        AuditLog[]
  ledTeams         Team[]             @relation("TeamLead")
  kbArticles       KbArticle[]
  kbVersions       KbArticleVersion[]
}

enum TicketScope {
  ALL
  TEAM
  OWN
}

model RoleDefinition {
  id                    String      @id @default(cuid())
  /// Stable identifier referenced by workflows (allowedRoles / approverRole), e.g. "ADMIN", "CAB".
  key                   String      @unique
  name                  String
  description           String?
  baseRole              Role
  permissions           String[]
  ticketScope           TicketScope @default(ALL)
  /// Asset environments this role may see; empty = all.
  inventoryEnvironments String[]
  isSystem              Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  users                 User[]
}

model Team {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  email       String?
  leadId      String?
  lead        User?             @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  calendarId  String?
  calendar    BusinessCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  members     TeamMember[]
  tickets     Ticket[]
}

model TeamMember {
  userId String
  teamId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

enum CustomerTier {
  STANDARD
  PREMIUM
  ENTERPRISE
}

model Organization {
  id        String       @id @default(cuid())
  name      String       @unique
  domain    String?
  tier      CustomerTier @default(STANDARD)
  industry  String?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  contacts  Contact[]
  tickets   Ticket[]
}

model Contact {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  phone          String?
  title          String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tickets        Ticket[]
}

// ─── Tickets & workflow ──────────────────────────────────────────────────────

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  CHANGE
  PROBLEM
  TASK
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum ApprovalState {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Workflow {
  id          String     @id @default(cuid())
  name        String
  description String?
  ticketType  TicketType
  version     Int
  isActive    Boolean    @default(true)
  /// { initialStatus, statuses[], transitions[] } — see src/workflows/workflow.types.ts
  definition  Json
  createdAt   DateTime   @default(now())
  tickets     Ticket[]

  @@unique([name, version])
  @@index([ticketType, isActive])
}

model SlaPolicy {
  id                String   @id @default(cuid())
  priority          Priority @unique
  firstResponseMins Int
  resolutionMins    Int
  /// Count only working time from the team's (or default) business calendar.
  businessHours     Boolean  @default(true)
  /// Warn assignee/channels when this many minutes remain before a target.
  warnBeforeMins    Int      @default(30)
  updatedAt         DateTime @updatedAt
}

model BusinessCalendar {
  id        String   @id @default(cuid())
  name      String   @unique
  timezone  String
  /// { mon: [["09:00","18:00"]], tue: [...], ..., sun: [] }
  hours     Json
  /// ISO dates (YYYY-MM-DD) treated as non-working days
  holidays  String[]
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teams     Team[]
}

model EscalationPolicy {
  id         String     @id @default(cuid())
  name       String
  enabled    Boolean    @default(true)
  /// Empty = applies to every priority. First matching policy (by sortOrder) wins.
  priorities Priority[]
  /// [{ afterMins, notify: ("assignee"|"team"|"team_lead"|"admins")[], userIds?: string[], bumpPriority?: boolean, reassignToLead?: boolean }]
  levels     Json
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
}

// ─── Integrations ────────────────────────────────────────────────────────────

enum ChannelKind {
  SLACK
  TEAMS
}

model IntegrationChannel {
  id             String      @id @default(cuid())
  name           String
  kind           ChannelKind
  webhookUrl     String
  /// e.g. ticket.created, ticket.assigned, sla.warning, sla.breached, sla.escalated, approval.requested, approval.decided, kb.published
  events         String[]
  /// Empty = all priorities / all teams
  priorities     Priority[]
  teamIds        String[]
  enabled        Boolean     @default(true)
  lastDeliveryAt DateTime?
  lastError      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ─── Knowledge base & service catalog ────────────────────────────────────────

enum KbStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum KbVisibility {
  PUBLIC
  INTERNAL
}

model KbCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  icon        String?
  sortOrder   Int         @default(0)
  articles    KbArticle[]
}

model KbArticle {
  id          String             @id @default(cuid())
  title       String
  slug        String             @unique
  body        String             @db.Text
  excerpt     String?
  categoryId  String?
  category    KbCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status      KbStatus           @default(DRAFT)
  visibility  KbVisibility       @default(PUBLIC)
  tags        String[]
  authorId    String
  author      User               @relation(fields: [authorId], references: [id])
  version     Int                @default(1)
  views       Int                @default(0)
  helpfulYes  Int                @default(0)
  helpfulNo   Int                @default(0)
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  versions    KbArticleVersion[]

  @@index([status, visibility])
}

model KbArticleVersion {
  id        String    @id @default(cuid())
  articleId String
  article   KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version   Int
  title     String
  body      String    @db.Text
  editorId  String
  editor    User      @relation(fields: [editorId], references: [id])
  createdAt DateTime  @default(now())

  @@unique([articleId, version])
}

model CatalogItem {
  id                  String     @id @default(cuid())
  name                String
  description         String
  icon                String?
  category            String
  ticketType          TicketType @default(SERVICE_REQUEST)
  priority            Priority   @default(P3)
  teamId              String?
  /// [{ key, label, type: "text"|"textarea"|"select"|"number"|"checkbox", required?, options?: string[], help? }]
  fields              Json       @default("[]")
  active              Boolean    @default(true)
  visibleToRequesters Boolean    @default(true)
  sortOrder           Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  tickets             Ticket[]
}

model AutomationRule {
  id         String   @id @default(cuid())
  name       String
  enabled    Boolean  @default(true)
  trigger    String   @default("ticket.created")
  /// { type?: TicketType[], priority?: Priority[], category?: string[], titleContains?: string }
  conditions Json     @default("{}")
  /// { teamId?, assigneeId?, priority?, addTags?: string[] }
  actions    Json     @default("{}")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model Ticket {
  id               String        @id @default(cuid())
  number           Int           @unique @default(autoincrement())
  title            String
  description      String        @db.Text
  type             TicketType
  priority         Priority
  status           String
  statusCategory   String        @default("TODO")
  category         String?
  tags             String[]
  customFields     Json          @default("{}")
  workflowId       String
  workflow         Workflow      @relation(fields: [workflowId], references: [id])
  requesterId      String
  requester        User          @relation("TicketRequester", fields: [requesterId], references: [id])
  assigneeId       String?
  assignee         User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  teamId           String?
  team             Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contactId        String?
  contact          Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  parentId         String?
  parent           Ticket?       @relation("TicketHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Ticket[]      @relation("TicketHierarchy")
  responseDueAt    DateTime?
  resolutionDueAt  DateTime?
  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  slaBreached      Boolean       @default(false)
  slaBreachedAt    DateTime?
  slaWarnedAt      DateTime?
  slaPausedAt      DateTime?
  escalationLevel  Int           @default(0)
  catalogItemId    String?
  catalogItem      CatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  comments  Comment[]
  events    TicketEvent[]
  approvals ApprovalRequest[]
  assets    TicketAsset[]

  @@index([statusCategory])
  @@index([assigneeId])
  @@index([teamId])
  @@index([requesterId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model ApprovalRequest {
  id            String        @id @default(cuid())
  ticketId      String
  ticket        Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  transitionKey String
  /// Role key (e.g. "CAB") or base role (e.g. "APPROVER") allowed to decide.
  approverRole  String
  state         ApprovalState @default(PENDING)
  requestedById String
  requestedBy   User          @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?         @relation("ApprovalDecider", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  comment       String?
  createdAt     DateTime      @default(now())

  @@index([state, approverRole])
}

// ─── Inventory ───────────────────────────────────────────────────────────────

enum AssetType {
  EC2_INSTANCE
  LOAD_BALANCER
  TARGET_GROUP
  IAM_USER
}

enum SyncStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model AwsAccount {
  id              String      @id @default(cuid())
  name            String
  accountId       String      @unique
  roleArn         String?
  /// Optional static keys for this account. Never returned by the API.
  accessKeyId     String?
  secretAccessKey String?
  sessionToken    String?
  externalId      String
  regions         String[]
  enabled         Boolean     @default(true)
  /// Legacy demo flag. Live AWS collection is used unless ALLOW_DEMO_AWS=true.
  mock            Boolean     @default(false)
  lastSyncAt      DateTime?
  lastSyncStatus  SyncStatus?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  assets          Asset[]
  syncRuns        SyncRun[]
}

model SyncRun {
  id           String     @id @default(cuid())
  awsAccountId String
  awsAccount   AwsAccount @relation(fields: [awsAccountId], references: [id], onDelete: Cascade)
  status       SyncStatus @default(QUEUED)
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  stats        Json?
  error        String?

  @@index([awsAccountId, startedAt])
}

model Asset {
  id           String          @id @default(cuid())
  awsAccountId String
  awsAccount   AwsAccount      @relation(fields: [awsAccountId], references: [id], onDelete: Cascade)
  type         AssetType
  arn          String          @unique
  resourceId   String
  name         String
  region       String
  state        String
  attributes   Json            @default("{}")
  tags         Json            @default("{}")
  owner        String?
  environment  String?
  lastSeenAt   DateTime        @default(now())
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tickets      TicketAsset[]
  outgoing     AssetRelation[] @relation("RelationFrom")
  incoming     AssetRelation[] @relation("RelationTo")
  changes      AssetChange[]

  @@index([awsAccountId, type])
  @@index([type, region])
}

model AssetRelation {
  fromId String
  toId   String
  type   String
  from   Asset  @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Asset  @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId, type])
}

model AssetChange {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind      String
  changes   Json
  createdAt DateTime @default(now())

  @@index([assetId, createdAt])
}

model TicketAsset {
  ticketId String
  assetId  String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([ticketId, assetId])
}
